<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- O Metric armazena dados financeiros sensíveis em SQLite local.
         Desabilitamos o backup automático do Android (allowBackup="false")
         para evitar que esses dados saiam do aparelho sem ação explícita do usuário.
         Este arquivo é mantido vazio intencionalmente: nenhum diretório/preference
         é incluído no backup do sistema. -->
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
